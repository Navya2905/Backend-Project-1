# Copy to .env and fill in. Never commit .env.

# --- Required ---
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/documind
# Any random string of 32+ characters, e.g. the output of: openssl rand -hex 32
JWT_SECRET=

# --- Optional (defaults shown) ---
# PORT=3000
# JWT_EXPIRES_IN=1h
# REDIS_URL=redis://localhost:6379
# QUEUE_PREFIX=documind
# UPLOAD_DIR=uploads
# MAX_UPLOAD_MB=20

# --- AI providers ---
# "local" works offline with no key: keyword-based search and extractive answers.
# Switch to real models for meaning-based search and written answers.
# EMBEDDING_PROVIDER=local        # local | voyage | openai
# VOYAGE_API_KEY=
# VOYAGE_MODEL=voyage-3.5
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM_PROVIDER=local              # local | anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Passages less similar than this are ignored; if none remain, DocuMind answers
# "I couldn't find this". Defaults: local 0.1, voyage 0.3, openai 0.25 (untuned starting points).
# RETRIEVAL_MIN_SIMILARITY=
